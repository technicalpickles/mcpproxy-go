# Reduce build context size for faster builds
.git
.gitignore
.DS_Store

# Docker & build stuff that wouldn't go into the image
.dockerignore
Makefile
Dockerfile
docker-bake.hcl
docker-compose.yml
.golangci.yml

# CI
.github/

# Build artifacts
bin/
dist/
build/
*.tar.gz
*.zip
*.dmg

# Test and coverage outputs
coverage*
*.out

# built binaries
mcpproxy
# documentation not needed during builds
docs/
*.md
LICENSE

# scripts not needed in the container
scripts/

# logs
logs/
 
# Large local caches and data not needed in build context
.cache/
data/
tmp/
*.log
*.prof
*.pprof
go.work
go.work.sum
