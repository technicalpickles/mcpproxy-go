# Reduce build context size for faster builds
.git
.gitignore
.DS_Store

# Docker host stuff
Dockerfile
docker-bake.hcl
docker-compose.yml

# CI and local notes
.github/
scratch/

# Build artifacts
bin/
dist/
build/
*.tar.gz
*.zip
*.dmg

# Test and coverage outputs
coverage*
*.out

# built binaries
mcpproxy
# documentation not needed during builds
docs/
 
# Large local caches and data not needed in build context
.cache/
data/
tmp/
*.log
*.prof
*.pprof
go.work
go.work.sum
